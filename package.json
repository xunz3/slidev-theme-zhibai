{
	"name": "slidev-theme-zhubai",
	"version": "0.5.0",
	"type": "module",
	"description": "A Chinese-first editorial Slidev theme: paper, ink, vermilion seals, and five presentation presets.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xunz3/slidev-theme-zhubai.git"
	},
	"homepage": "https://github.com/xunz3/slidev-theme-zhubai#readme",
	"bugs": {
		"url": "https://github.com/xunz3/slidev-theme-zhubai/issues"
	},
	"keywords": [
		"presentation",
		"slidev-theme",
		"slidev",
		"slides"
	],
	"files": [
		"assets/ICT/SOURCES.md",
		"assets/ICT/signature-official.png",
		"assets/UCAS/emblem-name-bilingual-hz.svg",
		"components",
		"internals",
		"layouts",
		"setup",
		"styles",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=20.19.0",
		"slidev": ">=52.15.2"
	},
	"scripts": {
		"assets:check": "node tests/quality/assets.spec.mjs",
		"build": "slidev build example.md",
		"build:fixture": "slidev build fixtures/elements-gallery.md --out dist-fixture",
		"dev": "slidev example.md --open",
		"dev:fixture": "slidev fixtures/elements-gallery.md --open",
		"export": "slidev export example.md",
		"quality": "node scripts/run-quality-gates.mjs",
		"quality:design": "node tests/quality/zhubai-design.spec.mjs",
		"screenshot": "slidev export example.md --format png",
		"build:default": "slidev build fixtures/default-preset.md --out dist-default",
		"screenshot:default": "slidev export fixtures/default-preset.md --format png --output dist-default/default-preset",
		"build:ucas": "slidev build fixtures/ucas-preset.md --out dist-ucas",
		"screenshot:ucas": "slidev export fixtures/ucas-preset.md --format png --output dist-ucas/ucas-preset",
		"build:ict": "slidev build fixtures/ict-preset.md --out dist-ict",
		"screenshot:ict": "slidev export fixtures/ict-preset.md --format png --output dist-ict/ict-preset",
		"build:zhubai": "slidev build fixtures/zhubai-preset.md --out dist-zhubai",
		"screenshot:zhubai": "slidev export fixtures/zhubai-preset.md --format png --output dist-zhubai/zhubai-preset",
		"build:qingdai": "slidev build fixtures/qingdai-preset.md --out dist-qingdai",
		"screenshot:qingdai": "slidev export fixtures/qingdai-preset.md --format png --output dist-qingdai/qingdai-preset",
		"build:songmo": "slidev build fixtures/songmo-preset.md --out dist-songmo",
		"screenshot:songmo": "slidev export fixtures/songmo-preset.md --format png --output dist-songmo/songmo-preset",
		"check": "node scripts/check-presentation-css.mjs",
		"test:release": "node --test tests/release.spec.mjs",
		"package:check": "node scripts/check-package.mjs",
		"release:check": "node scripts/validate-release.mjs"
	},
	"dependencies": {
		"@slidev/client": "^52.15.2"
	},
	"devDependencies": {
		"@slidev/cli": "^52.15.2",
		"@slidev/types": "^52.15.2",
		"axe-core": "4.12.1",
		"playwright-chromium": "^1.61.1",
		"typescript": "5.9.3",
		"vite": "8.0.13"
	},
	"//": "Learn more: https://sli.dev/guide/write-theme",
	"slidev": {
		"colorSchema": "both",
		"defaults": {
			"colorSchema": "light",
			"aspectRatio": "16:9",
			"fonts": {
				"sans": "Inter, Noto Sans SC",
				"serif": "Libertinus Serif, Noto Serif SC",
				"mono": "JetBrains Mono",
				"webfonts": [
					"Inter",
					"Libertinus Serif",
					"JetBrains Mono"
				],
				"local": [
					"Noto Sans SC",
					"Noto Serif SC"
				],
				"weights": "400,600,700",
				"italic": true
			}
		}
	},
	"packageManager": "pnpm@11.13.1",
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	}
}

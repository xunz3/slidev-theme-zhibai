{
	"name": "slidev-theme-lilas",
	"version": "0.1.10",
	"type": "module",
	"description": "A standalone Slidev theme with reusable presets and optional Obsidian integration.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xunz3/slidev-theme-4obsidian.git"
	},
	"homepage": "https://github.com/xunz3/slidev-theme-4obsidian#readme",
	"bugs": {
		"url": "https://github.com/xunz3/slidev-theme-4obsidian/issues"
	},
	"keywords": [
		"obsidian",
		"obsidian-slidev",
		"presentation",
		"slidev-theme",
		"slidev",
		"slides"
	],
	"files": [
		"assets/ICT",
		"assets/UCAS",
		"components",
		"internals",
		"layouts",
		"public/obsidian-card.svg",
		"setup",
		"styles",
		"README.md"
	],
	"engines": {
		"node": ">=20.19.0"
	},
	"scripts": {
		"assets:optimize": "node scripts/optimize-brand-assets.mjs",
		"assets:check": "node --test tests/quality/assets.spec.mjs",
		"build": "slidev build example.md",
		"build:fixture": "slidev build fixtures/obsidian-protocol.md --out dist-fixture",
		"dev": "slidev example.md --open",
		"dev:fixture": "slidev fixtures/obsidian-protocol.md --open",
		"export": "slidev export example.md",
		"quality": "node scripts/run-quality-gates.mjs",
		"quality:update-visual-baselines": "node scripts/run-quality-gates.mjs --update-visual-baselines",
		"screenshot": "slidev export example.md --format png",
		"build:default": "slidev build fixtures/default-preset.md --out dist-default",
		"screenshot:default": "slidev export fixtures/default-preset.md --format png --output dist-default/default-preset",
		"build:ucas": "slidev build fixtures/ucas-preset.md --out dist-ucas",
		"screenshot:ucas": "slidev export fixtures/ucas-preset.md --format png --output dist-ucas/ucas-preset",
		"build:ict": "slidev build fixtures/ict-preset.md --out dist-ict",
		"screenshot:ict": "slidev export fixtures/ict-preset.md --format png --output dist-ict/ict-preset"
	},
	"dependencies": {
		"@slidev/client": "^52.15.2"
	},
	"devDependencies": {
		"@slidev/cli": "^52.15.2",
		"@slidev/types": "^52.15.2",
		"axe-core": "4.12.1",
		"playwright-chromium": "^1.61.1",
		"slidev-pane": "0.1.9",
		"typescript": "5.9.3",
		"vite": "8.0.13"
	},
	"//": "Learn more: https://sli.dev/guide/write-theme.html",
	"slidev": {
		"colorSchema": "both",
		"defaults": {
			"aspectRatio": "16:9",
			"fonts": {
				"sans": "Source Sans 3, Noto Sans SC",
				"serif": "Source Serif 4, Noto Serif SC",
				"mono": "JetBrains Mono",
				"webfonts": [
					"Source Sans 3",
					"Source Serif 4",
					"JetBrains Mono"
				],
				"local": [
					"Noto Sans SC",
					"Noto Serif SC"
				],
				"weights": "400,500,600,700",
				"italic": true
			}
		}
	},
	"obsidianSlidev": {
		"support": {
			"schemaVersion": 1,
			"core": {
				"id": "obsidian-slidev/core",
				"ranges": [
					{
						"minInclusive": "1.0.0",
						"maxExclusive": "1.1.0"
					}
				]
			},
			"profiles": [
				{
					"id": "obsidian-slidev/presentation",
					"ranges": [
						{
							"minInclusive": "1.0.0",
							"maxExclusive": "1.1.0"
						}
					]
				}
			]
		}
	}
}
